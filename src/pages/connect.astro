---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-bold mb-2">Connect</h1>
    <p class="text-slate-500 mb-10">Open to Blue Team opportunities</p>

    <div class="space-y-6">
      <a 
        href="mailto:iamdonu@proton.me" 
        class="flex items-center gap-4 p-4 rounded-lg border border-slate-800 hover:border-cyan-700 hover:bg-slate-900/50 transition group"
      >
        <span class="text-cyan-500 font-mono text-sm w-20">Email</span>
        <span class="text-slate-300 group-hover:text-white">iamdonu@proton.me</span>
      </a>

      <a 
        href="https://www.linkedin.com/in/harshalpandya" 
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-4 p-4 rounded-lg border border-slate-800 hover:border-cyan-700 hover:bg-slate-900/50 transition group"
      >
        <span class="text-cyan-500 font-mono text-sm w-20">LinkedIn</span>
        <span class="text-slate-300 group-hover:text-white">linkedin.com/in/harshalpandya</span>
      </a>

      <a 
        href="https://www.tryhackme.com/p/iamdonu" 
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-4 p-4 rounded-lg border border-slate-800 hover:border-cyan-700 hover:bg-slate-900/50 transition group"
      >
        <span class="text-cyan-500 font-mono text-sm w-20">TryHackMe</span>
        <span class="text-slate-300 group-hover:text-white">tryhackme.com/p/iamdonu</span>
      </a>

      <a 
        href="https://www.github.com/iamdonu" 
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-4 p-4 rounded-lg border border-slate-800 hover:border-cyan-700 hover:bg-slate-900/50 transition group"
      >
        <span class="text-cyan-500 font-mono text-sm w-20">GitHub</span>
        <span class="text-slate-300 group-hover:text-white">github.com/iamdonu</span>
      </a>
    </div>
  </main>
</Layout>
